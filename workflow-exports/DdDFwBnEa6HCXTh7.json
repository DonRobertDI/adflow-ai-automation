    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    c.campaign_code,\n    c.status,\n    c.product_service,\n    c.objective,\n    c.brand_tone,\n    c.created_at,\n    c.updated_at,\n\n    cl.client_code,\n    cl.name AS client_name,\n    cl.company_name,\n\n    COUNT(DISTINCT cv.id)\n        AS version_count,\n\n    COUNT(DISTINCT pt.id)\n        AS production_task_count,\n\n    COUNT(\n        DISTINCT CASE\n            WHEN pt.status = 'completed'\n                THEN pt.id\n        END\n    ) AS completed_task_count\n\nFROM campaigns c\n\nJOIN clients cl\n    ON cl.id = c.client_id\n\nLEFT JOIN campaign_versions cv\n    ON cv.campaign_id = c.id\n\nLEFT JOIN production_tasks pt\n    ON pt.campaign_id = c.id\n\nWHERE c.campaign_code = $1\n\nGROUP BY\n    c.id,\n    cl.id;",
        "options": {
          "queryReplacement": "={{ $json.campaign_code }}"
        }
      },
