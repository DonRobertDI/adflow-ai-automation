    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    c.campaign_code,\n    cl.company_name,\n    cv.version_number,\n    cv.model_name,\n    cv.prompt_version,\n    cv.content,\n    a.reviewer_name,\n    a.reviewer_email,\n    a.feedback,\n    a.decided_at\n\nFROM campaigns c\n\nJOIN clients cl\n    ON cl.id = c.client_id\n\nJOIN campaign_versions cv\n    ON cv.campaign_id = c.id\n\nJOIN approvals a\n    ON a.campaign_version_id = cv.id\n\nWHERE c.campaign_code = $1\n\n  AND a.decision = 'approved'\n\nORDER BY cv.version_number DESC\n\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.campaign_code }}"
        }
      },
